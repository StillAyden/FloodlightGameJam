  m_Script: {fileID: 11500000, guid: a7218b0975c52c646a3bd2b6917112e0, type: 3}
  m_Name: Day6_MrMiller
  m_EditorClassIdentifier: 
  dialogueLines:
  - name: MR MILLER
    text: "Hey, I had to\u2026 uhm\u2026 leave town for the day. I had something
      unexpected come up."
    clip: {fileID: 8300000, guid: 1458fdab3a5a3104fa12aafc047b9528, type: 3}
  - name: MR MILLER
    text: Have a look at your inbox. I left a document that I need you to sign, just
      the witness section.
    clip: {fileID: 8300000, guid: 1299a061db90d304494ed2983fb406b5, type: 3}
  - name: MR MILLER
    text: "I need that faxed ASAP. Don\u2019t even bother reading it, it\u2019s nothing
      that concerns you.\r\n"
    clip: {fileID: 8300000, guid: f7d9621a87673274d8916b78f3958d76, type: 3}
  - name: MR MILLER
    text: "Make sure everything runs smoothly while I\u2019m gone\u2026 Ok."
    clip: {fileID: 8300000, guid: 82a3d24d295b1e343a866bc51ce761c9, type: 3}
