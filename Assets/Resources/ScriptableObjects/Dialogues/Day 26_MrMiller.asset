  m_Script: {fileID: 11500000, guid: a7218b0975c52c646a3bd2b6917112e0, type: 3}
  m_Name: Day 26_MrMiller
  m_EditorClassIdentifier: 
  dialogueLines:
  - name: MYSTERIOUS VOICE
    text: Put me through to Miller. PRESS 03
    clip: {fileID: 8300000, guid: 6e6ea83bf8a402a488c1a0f8034bbfad, type: 3}
  - name: 'MR MILLER '
    text: "Owen speaking\u2026 How can I help?"
    clip: {fileID: 8300000, guid: 3a7a22e74fdf9814798ee85fdaa0fe2d, type: 3}
  - name: MYSTERIOUS VOICE
    text: "Hey boss, we\u2019ve been experiencing some push-back from our latest
      contract. \r\nNon-compliance.\r\n"
    clip: {fileID: 8300000, guid: 10dd657acaf93654f9b9c3369bdd21f9, type: 3}
  - name: MR MILLER
    text: "Convenient\u2026 You manage to get your hands on a little \u201Cnegotiation
      aid\u201D?\r\n"
    clip: {fileID: 8300000, guid: a3273251a32ffc14d99d90b71e6f0af1, type: 3}
  - name: MYSTERIOUS VOICE
    text: "Yes, it didn\u2019t come easy though. Rick\u2019s got a face full of dirt,
      but we got \u2018em eventually."
    clip: {fileID: 8300000, guid: 30c5e2630015c6447b94a40458fb39f2, type: 3}
  - name: 'MR MILLER '
    text: "Yeah? Well, let them know we mean business. We\u2019re not asking anymore.\r\n"
    clip: {fileID: 8300000, guid: 95f66dc92dee7524baf6da2a34f6c1aa, type: 3}
  - name: MYSTERIOUS VOICE
    text: Aye aye, leave it up to me
    clip: {fileID: 8300000, guid: 42c050b12e369ce4fb7adb6e58137188, type: 3}
