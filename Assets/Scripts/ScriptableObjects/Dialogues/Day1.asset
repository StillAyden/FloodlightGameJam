--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a7218b0975c52c646a3bd2b6917112e0, type: 3}
  m_Name: Day1
  m_EditorClassIdentifier: 
  dialogueLines:
  - name: 'MR MILLER '
    text: "Good! I\u2019m glad you know how to use a telephone already. This is Mr
      Miller... your boss."
    clip: {fileID: 8300000, guid: 5adbdcc849498d744a9a17f77c7b301d, type: 3}
  - name: 'MR MILLER '
    text: "I hope that you\u2019ve already begun to make yourself at home.\r"
    clip: {fileID: 8300000, guid: 701ad7b38f67c3b479ed8269cb54935c, type: 3}
  - name: 'MR MILLER '
    text: "I\u2019m sure you\u2019re familiar with the tasks I expect you to perform,
      but in case you aren\u2019t, here they are:"
    clip: {fileID: 8300000, guid: b4af546fdd1acc44ba9fbb22d1104562, type: 3}
  - name: 'MR MILLER '
    text: Answer the phone
    clip: {fileID: 8300000, guid: a205c1adeda2fb14aa361ee6cf72abec, type: 3}
  - name: 'MR MILLER '
    text: Send mail
    clip: {fileID: 8300000, guid: 6684cc16002d512418e218d0b6beb7f5, type: 3}
  - name: 'MR MILLER '
    text: Authorise documents
    clip: {fileID: 8300000, guid: a33dc9d5ecd7018428371231aad8c768, type: 3}
  - name: 'MR MILLER '
    text: Check e-mails
    clip: {fileID: 8300000, guid: f5c1f909d0b4ed742843ad69f4b8507c, type: 3}
  - name: 'MR MILLER '
    text: File important documents
    clip: {fileID: 8300000, guid: d3e343321e94cde40a0a4e57d9910d66, type: 3}
  - name: 'MR MILLER '
    text: 'Diarise my mee-   You get the point. '
    clip: {fileID: 8300000, guid: 92f3fa8e914093846bb94fdc9762ed4a, type: 3}
  - name: 'MR MILLER '
    text: So you can start by signing those purchase orders on your desk and posting
      them to the addresses associated with the appropriate company.
    clip: {fileID: 8300000, guid: cd315001cdd562a44ae9e3ec42986c4f, type: 3}
  - name: 'MR MILLER '
    text: You can find those in my diary.
    clip: {fileID: 8300000, guid: 4667133c7b7937b418b7a20e3cc63f72, type: 3}
