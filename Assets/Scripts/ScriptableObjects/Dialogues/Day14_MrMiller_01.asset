  dialogueLines:
  - name: 'MR MILLER '
    text: "Good Morning! I\u2019m sure you heard, a technician came in earlier today
      to get the computer device of yours working. "
    clip: {fileID: 8300000, guid: 44893085bd06eb247867eb076786c863, type: 3}
  - name: 'MR MILLER '
    text: "Get yourself accustomed to it and don\u2019t be shy to contact Amelia
      if you\u2019ve got any problems with it."
    clip: {fileID: 8300000, guid: 9672ec4d29ac3ed42a8a86e3a8d0285b, type: 3}
